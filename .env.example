# Copy to .env. Personal accounts only (docs/CLEAN_ROOM.md, G2).
POSTGRES_PASSWORD=change-me-admin
SWITCHBOARD_APP_PASSWORD=change-me-app
ASTERISK_ARI_PASSWORD=change-me-ari
INFERENCE_CONTEXT_SECRET=change-me-32-bytes-minimum-please
WHATSAPP_APP_SECRET=change-me-webhook
# Optional: without these the stack runs on replay ASR and no LLM layer.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
SWITCHBOARD_ADMIN_KEY=change-me-operator
REDIS_PASSWORD=change-me-redis

# Softphone on your LAN (see README, "Call it from your phone").
# HOST_LAN_IP is this machine's address on your Wi-Fi/LAN; ASR_MODE=live uses Deepgram for real speech.
HOST_LAN_IP=
PHONE_SIP_PASSWORD=
ASR_MODE=replay
# A second softphone signed in as "desk" plays the staff member: every transfer rings it.
DESK_SIP_PASSWORD=
